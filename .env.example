# GitHub Integration for Issue Reporting
# Create a GitHub Personal Access Token with 'repo' scope at:
# https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=tinur5/GaengleSimulator

# Email Fallback Configuration
# Used when GitHub integration is not available
# SMTP server settings (e.g., Gmail, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
EMAIL_FALLBACK_TO=tinur5@hotmail.com

# Home Assistant Live Integration
# Base URL of your Home Assistant instance (no trailing slash)
# Example: https://my-ha.duckdns.org:8123
