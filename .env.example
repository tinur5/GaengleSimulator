# GitHub Integration for Issue Reporting
# Create a GitHub Personal Access Token with 'repo' scope at:
# https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=tinur5/GaengleSimulator

# Email Fallback Configuration
# Used when GitHub integration is not available
# SMTP server settings (e.g., Gmail, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
EMAIL_FALLBACK_TO=tinur5@hotmail.com

# Home Assistant Live Integration
#
# HOW TO SET THESE VARIABLES:
#   - Local development: copy this file to ".env.local" (NOT ".env.example"!) and fill in your values.
#     ".env.local" is gitignored and will be loaded automatically by Next.js.
#   - Vercel deployment: add these as Environment Variables in your Vercel project settings
#     (Project → Settings → Environment Variables), then trigger a new deployment.
#
# NOTE: Editing this ".env.example" file has NO effect – it is never loaded by the application.
#
# Base URL of your Home Assistant instance (no trailing slash)
# For Nabu Casa: https://<hash>.ui.nabu.casa
# For local HA:  http://homeassistant.local:8123
HOME_ASSISTANT_URL=https://your-home-assistant-url:8123
#
# Long-Lived Access Token from Home Assistant
# Create at: https://<your-ha-url>/profile/security → Long-lived access tokens
# NEVER expose this token publicly – it is read server-side only.
HOME_ASSISTANT_TOKEN=your_long_lived_access_token_here
